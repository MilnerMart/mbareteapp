# Copiar a deploy/.env y completar. Este archivo NO se sube al repo.

# --- Urls publicas (como las ve el navegador) ---
FRONTEND_PUBLIC_URL=http://localhost:8080
BACKEND_PUBLIC_URL=http://localhost:8000
FRONTEND_PORT=8080
BACKEND_PORT=8000

# --- Claves de Laravel: generar una distinta para cada app con ---
#     echo "base64:$(openssl rand -base64 32)"
BACKEND_APP_KEY=
FRONTEND_APP_KEY=

# --- Base de datos ---
DB_DATABASE=muscleApp
DB_USERNAME=muscleRoot
DB_PASSWORD=cambiar-esta-clave
DB_ROOT_PASSWORD=cambiar-esta-clave-root

# --- Usuario administrador (se crea en la primera migracion) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin
ADMIN_LAST_NAME=MuscleApp

# Nombre del gimnasio base al que se asignan los registros sin codigo
BASE_GYM_NAME=Leoncio Gym
