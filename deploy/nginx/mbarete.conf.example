# Sitio de Mbarete App en un nginx que ya existe en el servidor (cuando no se usa Caddy).
# 1) Copiar:   sudo cp deploy/nginx/mbarete.conf.example /etc/nginx/sites-available/mbarete.duckdns.org.conf
# 2) Cambiar server_name por tu dominio y activar:
#      sudo ln -s /etc/nginx/sites-available/mbarete.duckdns.org.conf /etc/nginx/sites-enabled/
#      sudo nginx -t && sudo systemctl reload nginx
# 3) HTTPS gratis:   sudo certbot --nginx -d mbarete.duckdns.org   (agrega el bloque 443 y la redireccion)
server {
    listen 80;
    listen [::]:80;
    server_name mbarete.duckdns.org;

    # fotos de perfil y de ejercicios
    client_max_body_size 20M;

    location / {
        proxy_pass http://127.0.0.1:8280;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_read_timeout 60s;
    }
}
