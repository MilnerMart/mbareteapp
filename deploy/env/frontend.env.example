# Copiar a deploy/env/frontend.env en la EC2 y completar. Nunca subir el .env real al repositorio.
APP_NAME="Mbarete App"
APP_ENV=production
# Para uno nuevo: docker compose run --rm --no-deps frontend php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
# Url publica: http://IP-ELASTICA o https://tu-dominio
APP_URL=http://CAMBIAR
APP_LOCALE=es
APP_FALLBACK_LOCALE=en

# Backend por la red interna de Docker (no queda expuesto a internet)
BACKEND_API_URL=http://backend:8080/api/v1

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# Misma RDS, otra base (sesiones y cache del frontend)
DB_CONNECTION=mariadb
DB_HOST=CAMBIAR.xxxxxxxx.us-east-1.rds.amazonaws.com
DB_PORT=3306
DB_DATABASE=mbarete_front
DB_USERNAME=CAMBIAR
DB_PASSWORD=CAMBIAR

SESSION_DRIVER=database
SESSION_LIFETIME=120
# con HTTPS (dominio) poner en true
SESSION_SECURE_COOKIE=false
CACHE_STORE=database
QUEUE_CONNECTION=database
