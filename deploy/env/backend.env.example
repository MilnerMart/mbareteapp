# Copiar a deploy/env/backend.env en la EC2 y completar. Nunca subir el .env real al repositorio.
APP_NAME="Mbarete App API"
APP_ENV=production
# Usa el MISMO APP_KEY que tu backend local si migras la base: las credenciales de proveedores estan cifradas con el.
# Para uno nuevo: docker compose run --rm --no-deps backend php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
# El frontend llama al backend por la red interna de Docker con esta url
APP_URL=http://backend:8080
# Url publica del frontend: los enlaces de los correos (ej. confirmar email) apuntan aca. Igual al APP_URL de frontend.env
FRONTEND_URL=http://CAMBIAR
APP_LOCALE=es
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# RDS (endpoint en la consola de RDS > Connectivity & security)
DB_CONNECTION=mariadb
DB_HOST=CAMBIAR.xxxxxxxx.us-east-1.rds.amazonaws.com
DB_PORT=3306
DB_DATABASE=muscleApp
DB_USERNAME=CAMBIAR
DB_PASSWORD=CAMBIAR

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Solo se usan la primera vez que corren las migraciones en una base vacia (crea el admin y el gimnasio base)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin
ADMIN_LAST_NAME=MuscleApp
BASE_GYM_NAME="Leoncio Gym"
