# Variables de docker compose en el servidor: ./deploy-remote.sh push-env lo sube como .env en la raiz del proyecto.

# A) Servidor solo para Mbarete: Caddy atiende 80/443 y saca HTTPS solo para APP_DOMAIN (sin dominio: APP_DOMAIN=:80)
#COMPOSE_PROFILES=caddy
#APP_DOMAIN=mbarete.duckdns.org

# B) Servidor compartido con nginx propio (ej. droplet con otros sitios): sin Caddy, el frontend queda en este puerto
#    local y nginx le hace proxy (plantilla en deploy/nginx/mbarete.conf.example)
FRONTEND_PUBLISH=127.0.0.1:8280

# Docker anterior a 20.10.10 que no se puede actualizar: ademas copiar en el servidor
#   cp deploy/compat/docker-20.10.override.yml docker-compose.override.yml
