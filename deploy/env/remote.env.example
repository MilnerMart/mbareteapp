# Copiar a deploy/env/remote.env (no se sube a git). Lo usa ./deploy-remote.sh desde tu Mac.
# Usuario@IP del servidor (DigitalOcean: root@IP-del-droplet)
SERVER=root@CAMBIAR
# Clave SSH (opcional: vacio usa tu clave por defecto ~/.ssh/id_*)
SSH_KEY=
# Carpeta del proyecto dentro del home del servidor
APP_DIR=mbareteapp
BRANCH=main
REPO=https://github.com/MilnerMart/mbareteapp.git

# Base en un contenedor del servidor (ej. tu MySQL): nombre del contenedor y de la base.
# Vacio = base externa (ej. RDS): db-export/db-import usan los DB_* de deploy/env/backend.env.
DB_CONTAINER=
DB_NAME=muscleapp
